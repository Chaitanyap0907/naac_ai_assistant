# ============================================================
# IBM Cloud / watsonx.ai Configuration (Mandatory)
# ============================================================
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_CLOUD_URL=https://us-south.ml.cloud.ibm.com
IBM_PROJECT_ID=your_watsonx_project_id_here

# IBM Granite Model IDs (available on IBM watsonx.ai Lite)
GRANITE_MODEL_ID=ibm/granite-4-h-small
GRANITE_INSTRUCT_MODEL_ID=ibm/granite-4-h-small
GRANITE_EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr-v2

# ============================================================
# Vector Store / Embedding Configuration
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_CHUNK_SIZE=512
EMBEDDING_CHUNK_OVERLAP=64

# ============================================================
# Application Configuration
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=5050
APP_DEBUG=True
APP_TITLE=NAAC Accreditation AI Assistant
APP_VERSION=1.0.0

# ============================================================
# RAG Configuration
# ============================================================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_TOKENS=1024
RAG_TEMPERATURE=0.3

# ============================================================
# Document Store
# ============================================================
NAAC_DOCS_DIR=./data/naac_documents
SSR_TEMPLATES_DIR=./data/ssr_templates
REPORTS_DIR=./data/reports
